# ============================================================
# AIAuto — Central AI Automation Platform
# Copy this file to `.env` and adjust the values.
# The `.env` file is NEVER overwritten by the auto-updater.
# ============================================================

# --- Application ---
APP_NAME=AIAuto
ENV=production
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Database (PostgreSQL preferred; SQLite works for testing) ---
DATABASE_URL=postgresql+asyncpg://aiauto:aiauto@localhost:5432/aiauto
# DATABASE_URL=sqlite+aiosqlite:///./storage/aiauto.db

# --- Redis (queue, cache, realtime events, rate limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT ---
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# --- Storage ---
STORAGE_DIR=storage
UPLOAD_DIR=storage/uploads
RESULTS_DIR=storage/results
BACKUP_DIR=backups
MAX_UPLOAD_MB=50
STORAGE_LIMIT_GB=50

# --- Queue / jobs ---
MAX_CONCURRENT_JOBS=1
MAX_QUEUE_SIZE=200
JOB_RETRY_COUNT=2
JOB_TIMEOUT_SECONDS=600

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=10

# ============================================================
# Master computer (worker) settings
# ============================================================
# AI provider: "browser" drives the logged-in ChatGPT Pro session
# with Playwright; "api" uses the official OpenAI API instead
# (recommended where possible — set OPENAI_API_KEY below).
AI_PROVIDER=browser

# Attach to an already-running Chrome started with:
#   chrome.exe --remote-debugging-port=9222 --user-data-dir="C:\aiauto-chrome"
CHROME_CDP_URL=http://localhost:9222
# Fallback: launch our own Chrome with this persistent profile
CHROME_PROFILE_DIR=C:\aiauto-chrome
CHROME_HEADLESS=false
CHATGPT_URL=https://chatgpt.com
RESPONSE_TIMEOUT_SECONDS=480
# Delete each conversation from the ChatGPT account after capture
DELETE_CONVERSATIONS_AFTER_RUN=true

# Only used when AI_PROVIDER=api
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1

# ============================================================
# GitHub auto-update system (can also be configured from the
# Admin → Update page; values saved there are stored encrypted
# in the database and take precedence over these).
# ============================================================
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_TOKEN=
# Comma-separated paths the updater must NEVER overwrite
UPDATE_PROTECTED_PATHS=.env,config.php,storage,uploads,backups,logs,frontend/node_modules
# Exit the process after a successful update so the service
# manager (systemd / NSSM / Docker restart policy) restarts it
UPDATE_AUTO_RESTART=true
