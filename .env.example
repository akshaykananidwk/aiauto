# ============================================================
# AIAuto — Central AI Automation Platform
# Copy this file to `.env` and adjust the values (setup.py and
# the app itself do this automatically on first run, generating
# a random SECRET_KEY).
# The `.env` file is NEVER overwritten by the auto-updater.
# ============================================================

# --- Application ---
APP_NAME=AIAuto
# production | development | test
ENV=production
DEBUG=false
# Secret for JWT signing and stored-secret encryption.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8000

# --- Database ---
# SQLite works out of the box for evaluation/small teams.
# For production, switch to PostgreSQL (recommended):
#   DATABASE_URL=postgresql+asyncpg://aiauto:aiauto@localhost:5432/aiauto
DATABASE_URL=sqlite+aiosqlite:///./storage/aiauto.db

# --- Redis (queue, cache, realtime events, rate limiting, lockout) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT ---
# Access token lifetime in minutes; refresh token lifetime in days
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# Brute-force protection: lock an account after N failed logins for M minutes
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# --- Storage ---
STORAGE_DIR=storage
UPLOAD_DIR=storage/uploads
RESULTS_DIR=storage/results
BACKUP_DIR=backups
# Per-file upload cap and total storage cap
MAX_UPLOAD_MB=50
STORAGE_LIMIT_GB=50

# --- Queue / jobs ---
MAX_CONCURRENT_JOBS=1
MAX_QUEUE_SIZE=200
JOB_RETRY_COUNT=2
# Hard cap for one job, and how long to wait for the AI response
JOB_TIMEOUT_SECONDS=600
RESPONSE_TIMEOUT_SECONDS=480

# --- Rate limiting (per client IP, per minute) ---
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- Quotas (0 = unlimited; user/department settings override these) ---
DEFAULT_DAILY_LIMIT=0
DEFAULT_MONTHLY_LIMIT=0

# ============================================================
# Browser automation (worker on the master computer)
# The ONLY AI backend: the master computer's logged-in ChatGPT
# Pro browser session. No external AI APIs are used — ever.
# ============================================================
# Unique name per worker machine (defaults to hostname-pid)
WORKER_ID=

# Attach to Chrome started with
#   chrome.exe --remote-debugging-port=9222 --user-data-dir="C:\aiauto-chrome"
CHROME_CDP_URL=http://localhost:9222
# Fallback: launch our own Chrome with this persistent (logged-in) profile
CHROME_PROFILE_DIR=C:\aiauto-chrome
CHROME_HEADLESS=false
CHATGPT_URL=https://chatgpt.com
# Delete each conversation from the ChatGPT account after capturing results
DELETE_CONVERSATIONS_AFTER_RUN=true

# ============================================================
# Notifications
# ============================================================
# Email (SMTP) — leave SMTP_HOST empty to disable
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=aiauto@yourcompany.com
SMTP_TLS=true
# Telegram bot for per-user notifications (users set their chat ID in admin panel)
TELEGRAM_BOT_TOKEN=
# Generic webhook: every notification is POSTed here as JSON.
# Point it at Slack, a WhatsApp gateway (e.g. Twilio), or any internal system.
NOTIFY_WEBHOOK_URL=

# ============================================================
# Monitoring / maintenance
# ============================================================
# Alert admins when disk usage crosses this percentage
DISK_ALERT_PERCENT=90
# Daily automatic backup at HH:MM (UTC); empty = disabled
BACKUP_SCHEDULE_TIME=

# ============================================================
# GitHub auto-update system (also configurable from the
# Admin → Update page; values saved there are stored encrypted
# in the database and take precedence over these).
# ============================================================
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_TOKEN=
# Comma-separated paths the updater must NEVER overwrite
UPDATE_PROTECTED_PATHS=.env,config.php,storage,uploads,backups,logs,plugins,frontend/node_modules
# Exit the process after a successful update so the service manager
# (systemd / NSSM / Docker restart policy) restarts it on the new code
UPDATE_AUTO_RESTART=true
